/* Rofi Colors - Theme: pywal-generated */
/* Generated by theme-switch */

* {
    background:     #101e26;
    background-alt: #18262e;
    foreground:     #c3c6c8;
    selected:       #A78C6E;
    active:         #D6A274;
    urgent:         #68544C;

    normal-background: @background;
    normal-foreground: @foreground;
    active-background: #D6A274;
    active-foreground: #c3c6c8;
    urgent-background: #68544C;
    urgent-foreground: #c3c6c8;

    selected-normal-background: #A78C6E;
    selected-normal-foreground: #c3c6c8;
    selected-active-background: #D6A274;
    selected-active-foreground: #101e26;
    selected-urgent-background: #68544C;
    selected-urgent-foreground: #c3c6c8;

    alternate-normal-background: @background;
    alternate-normal-foreground: @foreground;
    alternate-active-background: @background;
    alternate-active-foreground: #D6A274;
    alternate-urgent-background: @background;
    alternate-urgent-foreground: #68544C;

    border-color: #5f6d74;
    spacing: 2;
}
