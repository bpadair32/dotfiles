/* Rofi Colors - Theme: gruvbox */
/* Generated by theme-switch */

* {
    background:     #282828;
    background-alt: #1d2021;
    foreground:     #ebdbb2;
    selected:       #504945;
    active:         #689d6a;
    urgent:         #fb4934;

    normal-background: @background;
    normal-foreground: @foreground;
    active-background: #504945;
    active-foreground: #ebdbb2;
    urgent-background: #504945;
    urgent-foreground: #fb4934;

    selected-normal-background: #504945;
    selected-normal-foreground: #ebdbb2;
    selected-active-background: #689d6a;
    selected-active-foreground: #282828;
    selected-urgent-background: #fb4934;
    selected-urgent-foreground: #282828;

    alternate-normal-background: @background;
    alternate-normal-foreground: @foreground;
    alternate-active-background: @background;
    alternate-active-foreground: #689d6a;
    alternate-urgent-background: @background;
    alternate-urgent-foreground: #fb4934;

    border-color: #665c54;
    spacing: 2;
}
