# .dockerignore — Exclude files that shouldn't be in the Docker build context

# Git metadata
.git/
.gitignore

# AI/editor artifacts
.claude/
scripts/.claude/
.playwright-mcp/
CLAUDE.md

# Large binaries / media not needed in container
hacker_yoda.jpeg

# Plugin directories — these are installed fresh during build
tmux/plugins/

# Dynamic/runtime themes generated by pywal/matugen
themes/_dynamic/

# Test artifacts
test.txt

# Editor-specific
.vscode/
*.swp
*.swo
