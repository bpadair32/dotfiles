# tmux colors - Theme: ${THEME_NAME}
# Generated by theme-switch. Sourced at the end of tmux.conf.
#
# This file owns tmux's whole look, status bar formats included: an inline
# #[fg=..,bg=..] inside a format beats the *-style options, so themed styles
# alone never reach a status bar whose formats carry their own colours.
# The bar background is "default" so it sits on kitty's own (translucent)
# background, like the rest of the terminal.

set -g status-style "bg=default,fg=${ON_SURFACE}"
set -g status-left-style "bg=default"
set -g status-right-style "bg=default"
set -g status-justify centre
set -g status-interval 1
set -g status-left-length 60
set -g status-right-length 150

# Left: session | user | window:pane.  Right: time | date | host.
set -g status-left "#[fg=${ON_PRIMARY},bg=${PRIMARY},bold] #S #[fg=${PRIMARY},bg=${SURFACE_CONTAINER_HIGHEST},nobold]#[fg=${ON_SURFACE},bg=${SURFACE_CONTAINER_HIGHEST}] #(whoami) #[fg=${SURFACE_CONTAINER_HIGHEST},bg=${SURFACE_CONTAINER_HIGH}]#[fg=${ON_SURFACE_VARIANT},bg=${SURFACE_CONTAINER_HIGH}] #I:#P #[fg=${SURFACE_CONTAINER_HIGH},bg=default]"
set -g status-right "#[fg=${SURFACE_CONTAINER_HIGH},bg=default]#[fg=${ON_SURFACE_VARIANT},bg=${SURFACE_CONTAINER_HIGH}] %H:%M:%S #[fg=${SURFACE_CONTAINER_HIGHEST},bg=${SURFACE_CONTAINER_HIGH}]#[fg=${ON_SURFACE},bg=${SURFACE_CONTAINER_HIGHEST}] %d-%b-%y #[fg=${PRIMARY},bg=${SURFACE_CONTAINER_HIGHEST}]#[fg=${ON_PRIMARY},bg=${PRIMARY},bold] #H "

set -g window-status-separator ""
set -g window-status-format "#[fg=${ON_SURFACE_VARIANT},bg=default] #I:#W#F "
set -g window-status-current-format "#[fg=${SURFACE_CONTAINER_HIGH},bg=default]#[fg=${PRIMARY},bg=${SURFACE_CONTAINER_HIGH},bold] #I:#W#F #[fg=${SURFACE_CONTAINER_HIGH},bg=default,nobold]"
set -g window-status-style "bg=default,fg=${ON_SURFACE_VARIANT}"
set -g window-status-current-style "bg=default,fg=${PRIMARY},bold"
set -g window-status-activity-style "bg=default,fg=${TERTIARY}"
set -g window-status-bell-style "bg=default,fg=${ERROR},bold"

set -g pane-border-style "fg=${OUTLINE_VARIANT}"
set -g pane-active-border-style "fg=${PRIMARY}"

set -g message-style "bg=${SURFACE_CONTAINER_HIGH},fg=${ON_SURFACE}"
set -g message-command-style "bg=${SURFACE_CONTAINER_HIGH},fg=${ON_SURFACE}"

# Popups (Ctrl+Shift+H pager, sessionx, floax) and menus (right-click).
set -g popup-style "bg=default,fg=${ON_SURFACE}"
set -g popup-border-style "fg=${PRIMARY}"
set -g menu-style "bg=${SURFACE_CONTAINER},fg=${ON_SURFACE}"
set -g menu-selected-style "bg=${PRIMARY},fg=${ON_PRIMARY}"
set -g menu-border-style "fg=${OUTLINE}"

# Selections use kitty's selection colours, so a mouse selection looks the
# same inside tmux as outside it.
set -g mode-style "bg=${SELECTION_BG},fg=${SELECTION_FG}"

set -g display-panes-colour "${OUTLINE}"
set -g display-panes-active-colour "${PRIMARY}"

set -g clock-mode-colour "${PRIMARY}"

set -g copy-mode-match-style "bg=${TERTIARY_CONTAINER},fg=${ON_TERTIARY_CONTAINER}"
set -g copy-mode-current-match-style "bg=${TERTIARY},fg=${ON_TERTIARY}"
