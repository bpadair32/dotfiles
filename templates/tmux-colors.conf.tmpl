# tmux colors - Theme: ${THEME_NAME}
# Generated by theme-switch. Sourced at the end of tmux.conf so it
# overrides whatever tmux-themepack set when tpm loaded.

set -g status-style "bg=${SURFACE_CONTAINER},fg=${ON_SURFACE}"
set -g status-left-style "bg=${PRIMARY},fg=${ON_PRIMARY},bold"
set -g status-right-style "bg=${SURFACE_CONTAINER},fg=${ON_SURFACE_VARIANT}"

set -g window-status-style "bg=${SURFACE_CONTAINER},fg=${ON_SURFACE_VARIANT}"
set -g window-status-current-style "bg=${SURFACE_CONTAINER_HIGH},fg=${PRIMARY},bold"
set -g window-status-activity-style "bg=${SURFACE_CONTAINER},fg=${TERTIARY}"
set -g window-status-bell-style "bg=${SURFACE_CONTAINER},fg=${ERROR},bold"

set -g pane-border-style "fg=${OUTLINE_VARIANT}"
set -g pane-active-border-style "fg=${PRIMARY}"

set -g message-style "bg=${SURFACE_CONTAINER_HIGH},fg=${ON_SURFACE}"
set -g message-command-style "bg=${SURFACE_CONTAINER_HIGH},fg=${ON_SURFACE}"

set -g mode-style "bg=${SECONDARY},fg=${ON_SECONDARY}"

set -g display-panes-colour "${OUTLINE}"
set -g display-panes-active-colour "${PRIMARY}"

set -g clock-mode-colour "${PRIMARY}"

set -g copy-mode-match-style "bg=${TERTIARY_CONTAINER},fg=${ON_TERTIARY_CONTAINER}"
set -g copy-mode-current-match-style "bg=${TERTIARY},fg=${ON_TERTIARY}"
