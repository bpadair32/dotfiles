/* Firefox chrome colors - Theme: ${THEME_NAME} */
/* Generated by theme-switch. Requires
   toolkit.legacyUserProfileCustomizations.stylesheets = true */

:root,
:root:-moz-lwtheme {
  /* Window / tab strip */
  --lwt-accent-color: ${SURFACE} !important;
  --lwt-accent-color-inactive: ${SURFACE_DIM} !important;
  --lwt-text-color: ${ON_SURFACE} !important;

  /* Toolbars */
  --toolbar-bgcolor: ${SURFACE_CONTAINER} !important;
  --toolbar-color: ${ON_SURFACE} !important;
  --toolbar-field-background-color: ${SURFACE_CONTAINER_HIGH} !important;
  --toolbar-field-color: ${ON_SURFACE} !important;
  --toolbar-field-border-color: ${OUTLINE_VARIANT} !important;
  --toolbar-field-focus-background-color: ${SURFACE_CONTAINER_HIGHEST} !important;
  --toolbar-field-focus-color: ${ON_SURFACE} !important;
  --toolbar-field-focus-border-color: ${PRIMARY} !important;
  --lwt-toolbar-field-highlight: ${PRIMARY} !important;
  --lwt-toolbar-field-highlight-text: ${ON_PRIMARY} !important;

  /* Toolbar buttons */
  --toolbarbutton-icon-fill: ${ON_SURFACE} !important;
  --toolbarbutton-icon-fill-attention: ${PRIMARY} !important;
  --toolbarbutton-hover-background: ${SURFACE_CONTAINER_HIGHEST} !important;
  --toolbarbutton-active-background: ${SURFACE_BRIGHT} !important;
  --toolbarbutton-border-radius: 6px !important;

  /* Tabs */
  --tab-selected-bgcolor: ${SURFACE_CONTAINER_HIGH} !important;
  --tab-selected-textcolor: ${ON_SURFACE} !important;
  --tab-selected-outline-color: ${OUTLINE_VARIANT} !important;
  --lwt-tab-line-color: ${PRIMARY} !important;
  --tab-line-color: ${PRIMARY} !important;

  /* Menus and popups */
  --arrowpanel-background: ${SURFACE_CONTAINER_HIGH} !important;
  --arrowpanel-color: ${ON_SURFACE} !important;
  --arrowpanel-border-color: ${OUTLINE_VARIANT} !important;
  --arrowpanel-dimmed: ${SURFACE_CONTAINER_HIGHEST} !important;
  --panel-separator-color: ${OUTLINE_VARIANT} !important;
  --panel-banner-item-update-supported-bgcolor: ${PRIMARY} !important;

  /* Urlbar results */
  --urlbar-box-bgcolor: ${SURFACE_CONTAINER_HIGH} !important;
  --urlbar-box-text-color: ${ON_SURFACE} !important;
  --urlbar-box-hover-bgcolor: ${SURFACE_CONTAINER_HIGHEST} !important;
  --urlbar-popup-url-color: ${PRIMARY} !important;
  --autocomplete-popup-highlight-background: ${PRIMARY} !important;
  --autocomplete-popup-highlight-color: ${ON_PRIMARY} !important;

  /* Sidebar (bookmarks, history, containers) */
  --lwt-sidebar-background-color: ${SURFACE_CONTAINER_LOW} !important;
  --lwt-sidebar-text-color: ${ON_SURFACE} !important;
  --sidebar-background-color: ${SURFACE_CONTAINER_LOW} !important;
  --sidebar-text-color: ${ON_SURFACE} !important;
  --sidebar-border-color: ${OUTLINE_VARIANT} !important;

  /* Findbar / misc */
  --focus-outline-color: ${PRIMARY} !important;
  --link-color: ${PRIMARY} !important;
  --error-text-color: ${ERROR} !important;
  --in-content-page-background: ${SURFACE} !important;
  --in-content-page-color: ${ON_SURFACE} !important;
}

/* Private browsing windows use their own accent */
:root[privatebrowsingmode="temporary"] {
  --lwt-accent-color: ${SURFACE_CONTAINER_LOWEST} !important;
  --toolbar-bgcolor: ${SURFACE_CONTAINER_LOW} !important;
}

/* Keep the window background from flashing the default grey */
#browser,
#tabbrowser-tabbox,
#tabbrowser-tabpanels {
  background-color: ${SURFACE} !important;
}
