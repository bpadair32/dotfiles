# k9s skin - Theme: ${THEME_NAME}
# Generated by theme-switch
k9s:
  body:
    fgColor: "${ON_SURFACE}"
    bgColor: "${SURFACE}"
    logoColor: "${PRIMARY}"
  prompt:
    fgColor: "${ON_SURFACE}"
    bgColor: "${SURFACE_CONTAINER}"
    suggestColor: "${ON_SURFACE_VARIANT}"
  info:
    fgColor: "${ON_SURFACE_VARIANT}"
    sectionColor: "${ON_SURFACE}"
  dialog:
    fgColor: "${ON_SURFACE}"
    bgColor: "${SURFACE_CONTAINER_HIGH}"
    buttonFgColor: "${ON_SURFACE}"
    buttonBgColor: "${SURFACE_CONTAINER_HIGHEST}"
    buttonFocusFgColor: "${ON_PRIMARY}"
    buttonFocusBgColor: "${PRIMARY}"
    labelFgColor: "${TERTIARY}"
    fieldFgColor: "${ON_SURFACE}"
  frame:
    border:
      fgColor: "${OUTLINE_VARIANT}"
      focusColor: "${PRIMARY}"
    menu:
      fgColor: "${ON_SURFACE}"
      keyColor: "${PRIMARY}"
      numKeyColor: "${SECONDARY}"
    crumbs:
      fgColor: "${ON_SURFACE}"
      bgColor: "${SURFACE_CONTAINER}"
      activeColor: "${PRIMARY}"
    status:
      newColor: "${PRIMARY}"
      modifyColor: "${SECONDARY}"
      addColor: "${TERTIARY}"
      errorColor: "${ERROR}"
      highlightColor: "${TERTIARY}"
      killColor: "${OUTLINE}"
      completedColor: "${ON_SURFACE_VARIANT}"
    title:
      fgColor: "${ON_SURFACE}"
      bgColor: "${SURFACE_CONTAINER}"
      highlightColor: "${PRIMARY}"
      counterColor: "${SECONDARY}"
      filterColor: "${TERTIARY}"
  views:
    charts:
      bgColor: "${SURFACE}"
      defaultDialColors:
        - "${PRIMARY}"
        - "${ERROR}"
      defaultChartColors:
        - "${PRIMARY}"
        - "${ERROR}"
    table:
      fgColor: "${ON_SURFACE}"
      bgColor: "${SURFACE}"
      cursorFgColor: "${ON_PRIMARY}"
      cursorBgColor: "${PRIMARY}"
      header:
        fgColor: "${ON_SURFACE_VARIANT}"
        bgColor: "${SURFACE_CONTAINER}"
        sorterColor: "${TERTIARY}"
    xray:
      fgColor: "${ON_SURFACE}"
      bgColor: "${SURFACE}"
      cursorColor: "${PRIMARY}"
      graphicColor: "${SECONDARY}"
    yaml:
      keyColor: "${PRIMARY}"
      colonColor: "${ON_SURFACE_VARIANT}"
      valueColor: "${ON_SURFACE}"
    logs:
      fgColor: "${ON_SURFACE}"
      bgColor: "${SURFACE}"
      indicator:
        fgColor: "${PRIMARY}"
        bgColor: "${SURFACE_CONTAINER}"
