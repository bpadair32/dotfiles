/* Zen Browser colors - Theme: ${THEME_NAME} */
/* Generated by theme-switch, appended after the shared Firefox rules.  */
/*                                                                     */
/* Zen redefines most standard Firefox chrome variables with           */
/* !important, so overriding those individually does not work. Instead  */
/* it derives its whole palette from two sources via color-mix():       */
/* --zen-primary-color (accents) and --zen-branding-dark (surfaces).    */
/* Setting those two recolors Zen coherently; the rest below are the    */
/* handful of values Zen hardcodes instead of deriving.                 */

:host(:is(.anonymous-content-host, notification-message)),
:root {
  /* The two sources everything else is mixed from */
  --zen-primary-color: ${PRIMARY} !important;
  --zen-branding-dark: ${SURFACE} !important;
  --zen-branding-paper: ${ON_SURFACE} !important;

  /* Values Zen hardcodes rather than deriving */
  --zen-main-browser-background: ${SURFACE} !important;
  --zen-main-browser-background-toolbar: ${SURFACE} !important;
  --zen-themed-toolbar-bg-transparent: ${SURFACE_CONTAINER} !important;
  --zen-dialog-background: ${SURFACE_CONTAINER_HIGH} !important;
  --zen-in-content-dialog-background: ${SURFACE_CONTAINER_HIGH} !important;
  --zen-urlbar-background: ${SURFACE_CONTAINER} !important;
  --zen-urlbar-background-base: ${SURFACE_CONTAINER} !important;
  --zen-input-border-color: ${OUTLINE_VARIANT} !important;
  --zen-colors-input-bg: ${SURFACE_CONTAINER_HIGH} !important;
  --zen-appcontent-border: ${OUTLINE_VARIANT} !important;
  --zen-sidebar-notification-bg: ${SURFACE_CONTAINER_HIGH} !important;
  --zen-sidebar-notification-outline: ${OUTLINE_VARIANT} !important;

  /* Toolbar and tab surfaces */
  --zen-toolbar-element-bg: ${SURFACE_CONTAINER_HIGH} !important;
  --zen-essential-tab-selected-bg: ${SURFACE_CONTAINER_HIGH} !important;
  --zen-essential-tab-selected-bg-hover: ${SURFACE_CONTAINER_HIGHEST} !important;
  --zen-split-view-active-tab-bg: ${SURFACE_CONTAINER_HIGH} !important;
  --zen-active-split-outline-color: ${PRIMARY} !important;
  --zen-folder-front-bgcolor: ${SURFACE_CONTAINER_HIGH} !important;
  --zen-folder-behind-bgcolor: ${SURFACE_CONTAINER} !important;
  --zen-folder-stroke: ${OUTLINE_VARIANT} !important;
  --zen-loading-progress-bar-color: ${PRIMARY} !important;
  --zen-drag-indicator-bg: ${PRIMARY} !important;
  --zen-sidebar-themed-icon-fill: ${ON_SURFACE} !important;
}
