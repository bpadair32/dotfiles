#![enable(implicit_some)]
#![enable(unwrap_newtypes)]
#![enable(unwrap_variant_newtypes)]
// rmpc theme - Theme: ${THEME_NAME}
// Generated by theme-switch from `rmpc theme` so it stays schema-complete.
(
    default_album_art_path: None,
    show_song_table_header: true,
    draw_borders: true,
    browser_column_widths: [20, 38, 42],
    background_color: "${SURFACE}",
    text_color: "${ON_SURFACE}",
    header_background_color: "${SURFACE_CONTAINER}",
    modal_background_color: "${SURFACE_CONTAINER_HIGH}",
    tab_bar: (
        enabled: true,
        active_style: (fg: "${ON_PRIMARY}", bg: "${PRIMARY}", modifiers: "Bold"),
        inactive_style: (fg: "${ON_SURFACE_VARIANT}", bg: "${SURFACE_CONTAINER}"),
    ),
    highlighted_item_style: (fg: "${PRIMARY}", modifiers: "Bold"),
    current_item_style: (fg: "${ON_PRIMARY}", bg: "${PRIMARY}", modifiers: "Bold"),
    borders_style: (fg: "${OUTLINE_VARIANT}"),
    highlight_border_style: (fg: "${PRIMARY}"),
    symbols: (song: "S", dir: "D", marker: "M", ellipsis: "..."),
    progress_bar: (
        symbols: ["-", ">", " "],
        track_style: (fg: "${SURFACE_CONTAINER_HIGH}"),
        elapsed_style: (fg: "${PRIMARY}"),
        thumb_style: (fg: "${PRIMARY}", bg: "${SURFACE_CONTAINER_HIGH}"),
    ),
    scrollbar: (
        symbols: ["│", "█", "▲", "▼"],
        track_style: (fg: "${SURFACE_CONTAINER_HIGH}"),
        ends_style: (fg: "${OUTLINE_VARIANT}"),
        thumb_style: (fg: "${PRIMARY}"),
    ),
    song_table_format: [
        (
            prop: (kind: Property(Artist),
                default: (kind: Text("Unknown"))
            ),
            width: "20%",
        ),
        (
            prop: (kind: Property(Title),
                default: (kind: Text("Unknown"))
            ),
            width: "35%",
        ),
        (
            prop: (kind: Property(Album), style: (fg: "${ON_SURFACE_VARIANT}"),
                default: (kind: Text("Unknown Album"), style: (fg: "${ON_SURFACE_VARIANT}"))
            ),
            width: "30%",
        ),
        (
            prop: (kind: Property(Duration),
                default: (kind: Text("-"))
            ),
            width: "15%",
            alignment: Right,
        ),
    ],
    layout: Split(
        direction: Vertical,
        panes: [
            (
                pane: Pane(Header),
                size: "2",
            ),
            (
                pane: Pane(Tabs),
                size: "3",
            ),
            (
                pane: Pane(TabContent),
                size: "100%",
            ),
            (
                pane: Pane(ProgressBar),
                size: "1",
            ),
        ],
    ),
    header: (
        rows: [
            (
                left: [
                    (kind: Text("["), style: (fg: "${TERTIARY}", modifiers: "Bold")),
                    (kind: Property(Status(StateV2(playing_label: "Playing", paused_label: "Paused", stopped_label: "Stopped"))), style: (fg: "${TERTIARY}", modifiers: "Bold")),
                    (kind: Text("]"), style: (fg: "${TERTIARY}", modifiers: "Bold"))
                ],
                center: [
                    (kind: Property(Song(Title)), style: (modifiers: "Bold"),
                        default: (kind: Text("No Song"), style: (modifiers: "Bold"))
                    )
                ],
                right: [
                    (kind: Property(Widget(Volume)), style: (fg: "${PRIMARY}"))
                ]
            ),
            (
                left: [
                    (kind: Property(Status(Elapsed))),
                    (kind: Text(" / ")),
                    (kind: Property(Status(Duration))),
                    (kind: Text(" (")),
                    (kind: Property(Status(Bitrate))),
                    (kind: Text(" kbps)"))
                ],
                center: [
                    (kind: Property(Song(Artist)), style: (fg: "${TERTIARY}", modifiers: "Bold"),
                        default: (kind: Text("Unknown"), style: (fg: "${TERTIARY}", modifiers: "Bold"))
                    ),
                    (kind: Text(" - ")),
                    (kind: Property(Song(Album)),
                        default: (kind: Text("Unknown Album"))
                    )
                ],
                right: [
                    (
                        kind: Property(Widget(States(
                            active_style: (fg: "${ON_SURFACE}", modifiers: "Bold"),
                            separator_style: (fg: "${OUTLINE}")))
                        ),
                        style: (fg: "${OUTLINE}")
                    ),
                ]
            ),
        ],
    ),
    browser_song_format: [
        (
            kind: Group([
                (kind: Property(Track)),
                (kind: Text(" ")),
            ])
        ),
        (
            kind: Group([
                (kind: Property(Artist)),
                (kind: Text(" - ")),
                (kind: Property(Title)),
            ]),
            default: (kind: Property(Filename))
        ),
    ],
)

