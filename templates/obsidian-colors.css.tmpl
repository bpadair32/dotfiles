/* Obsidian colors - Theme: ${THEME_NAME} */
/* Generated by theme-switch into <vault>/.obsidian/snippets/            */
/* Snippets load after the community theme, so these win on color while  */
/* the theme keeps supplying layout and typography.                      */

.theme-dark {
  /* Surfaces */
  --background-primary: ${SURFACE};
  --background-primary-alt: ${SURFACE_CONTAINER_LOW};
  --background-secondary: ${SURFACE_CONTAINER};
  --background-secondary-alt: ${SURFACE_CONTAINER_LOWEST};
  --background-modifier-border: ${OUTLINE_VARIANT};
  --background-modifier-border-hover: ${OUTLINE};
  --background-modifier-border-focus: ${PRIMARY};
  --background-modifier-hover: ${SURFACE_CONTAINER_HIGH};
  --background-modifier-active-hover: ${SURFACE_CONTAINER_HIGHEST};
  --background-modifier-form-field: ${SURFACE_CONTAINER_HIGH};
  --background-modifier-error: ${ERROR_CONTAINER};
  --background-modifier-error-hover: ${ERROR};
  --background-modifier-success: ${COLOR2};
  --modal-background: ${SURFACE_CONTAINER_HIGH};
  --prompt-border-color: ${OUTLINE_VARIANT};

  /* Text */
  --text-normal: ${ON_SURFACE};
  --text-muted: ${ON_SURFACE_VARIANT};
  --text-faint: ${OUTLINE};
  --text-accent: ${PRIMARY};
  --text-accent-hover: ${PRIMARY_FIXED_DIM};
  --text-on-accent: ${ON_PRIMARY};
  --text-error: ${ERROR};
  --text-success: ${COLOR2};
  --text-selection: ${SECONDARY_CONTAINER};
  --text-highlight-bg: ${TERTIARY_CONTAINER};

  /* Interactive elements */
  --interactive-normal: ${SURFACE_CONTAINER};
  --interactive-hover: ${SURFACE_CONTAINER_HIGH};
  --interactive-accent: ${PRIMARY};
  --interactive-accent-hover: ${PRIMARY_FIXED_DIM};
  --icon-color: ${ON_SURFACE_VARIANT};
  --icon-color-hover: ${ON_SURFACE};
  --icon-color-focused: ${PRIMARY};
  --checkbox-color: ${PRIMARY};
  --checkbox-color-hover: ${PRIMARY_FIXED_DIM};
  --checkbox-marker-color: ${ON_PRIMARY};

  /* Chrome */
  --titlebar-background: ${SURFACE_CONTAINER};
  --titlebar-background-focused: ${SURFACE_CONTAINER_HIGH};
  --titlebar-text-color: ${ON_SURFACE};
  --titlebar-text-color-focused: ${ON_SURFACE};
  --divider-color: ${OUTLINE_VARIANT};
  --scrollbar-bg: transparent;
  --scrollbar-thumb-bg: ${OUTLINE_VARIANT};
  --scrollbar-active-thumb-bg: ${OUTLINE};
  --tab-text-color-focused-active: ${ON_SURFACE};
  --tab-text-color-focused-active-current: ${PRIMARY};
  --ribbon-background: ${SURFACE_CONTAINER_LOWEST};

  /* Editor content */
  --h1-color: ${PRIMARY};
  --h2-color: ${PRIMARY};
  --h3-color: ${SECONDARY};
  --h4-color: ${SECONDARY};
  --h5-color: ${TERTIARY};
  --h6-color: ${TERTIARY};
  --link-color: ${PRIMARY};
  --link-color-hover: ${PRIMARY_FIXED_DIM};
  --link-external-color: ${SECONDARY};
  --link-external-color-hover: ${SECONDARY_FIXED_DIM};
  --link-unresolved-color: ${ERROR};
  --blockquote-border-color: ${OUTLINE};
  --hr-color: ${OUTLINE_VARIANT};
  --code-background: ${SURFACE_CONTAINER_LOW};
  --code-normal: ${ON_SURFACE_VARIANT};
  --code-comment: ${OUTLINE};
  --code-keyword: ${SECONDARY};
  --code-string: ${COLOR2};
  --code-function: ${PRIMARY};
  --code-value: ${TERTIARY};
  --tag-color: ${TERTIARY};
  --tag-background: ${TERTIARY_CONTAINER};
  --table-header-background: ${SURFACE_CONTAINER};
  --table-row-alt-background: ${SURFACE_CONTAINER_LOW};
  --table-border-color: ${OUTLINE_VARIANT};

  /* Graph and canvas */
  --graph-line: ${OUTLINE};
  --graph-node: ${ON_SURFACE};
  --graph-node-tag: ${TERTIARY};
  --graph-node-attachment: ${SECONDARY};
  --graph-node-unresolved: ${ERROR};
  --graph-node-focused: ${PRIMARY};
  --graph-text: ${ON_SURFACE};
  --canvas-background: ${SURFACE};
  --canvas-color: ${OUTLINE_VARIANT};
  --canvas-dot-pattern: ${OUTLINE_VARIANT};
}
