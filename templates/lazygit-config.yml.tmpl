# lazygit config - Theme: ${THEME_NAME}
# Generated by theme-switch. Edit templates/lazygit-config.yml.tmpl,
# not this file - it is overwritten on every theme switch.
gui:
  theme:
    activeBorderColor:
      - "${PRIMARY}"
      - bold
    inactiveBorderColor:
      - "${OUTLINE_VARIANT}"
    searchingActiveBorderColor:
      - "${TERTIARY}"
      - bold
    optionsTextColor:
      - "${ON_SURFACE_VARIANT}"
    selectedLineBgColor:
      - "${SURFACE_CONTAINER_HIGH}"
    inactiveViewSelectedLineBgColor:
      - "${SURFACE_CONTAINER}"
    cherryPickedCommitBgColor:
      - "${SECONDARY_CONTAINER}"
    cherryPickedCommitFgColor:
      - "${SECONDARY}"
    markedBaseCommitBgColor:
      - "${TERTIARY_CONTAINER}"
    markedBaseCommitFgColor:
      - "${TERTIARY}"
    unstagedChangesColor:
      - "${ERROR}"
    defaultFgColor:
      - "${ON_SURFACE}"
