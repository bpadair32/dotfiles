/* Firefox in-content colors - Theme: ${THEME_NAME} */
/* Generated by theme-switch. Requires
   toolkit.legacyUserProfileCustomizations.stylesheets = true */

/* Blank and new-tab pages, so navigation doesn't flash white */
@-moz-document url("about:blank"),
               url("about:newtab"),
               url("about:home"),
               url("about:privatebrowsing") {
  :root,
  body {
    background-color: ${SURFACE} !important;
    color: ${ON_SURFACE} !important;
  }
}

/* Built-in about: pages (preferences, addons, config, ...) */
@-moz-document url-prefix("about:") {
  :root {
    --in-content-page-background: ${SURFACE} !important;
    --in-content-page-color: ${ON_SURFACE} !important;
    --in-content-box-background: ${SURFACE_CONTAINER} !important;
    --in-content-box-background-odd: ${SURFACE_CONTAINER_LOW} !important;
    --in-content-box-border-color: ${OUTLINE_VARIANT} !important;
    --in-content-text-color: ${ON_SURFACE} !important;
    --in-content-deemphasized-text: ${ON_SURFACE_VARIANT} !important;
    --in-content-accent-color: ${PRIMARY} !important;
    --in-content-primary-button-background: ${PRIMARY} !important;
    --in-content-primary-button-text-color: ${ON_PRIMARY} !important;
    --in-content-button-background: ${SURFACE_CONTAINER_HIGH} !important;
    --in-content-button-text-color: ${ON_SURFACE} !important;
    --in-content-link-color: ${PRIMARY} !important;
    --in-content-danger-button-background: ${ERROR} !important;
    --link-color: ${PRIMARY} !important;
  }
}

/* Reader mode dark scheme */
@-moz-document url-prefix("about:reader") {
  body.dark {
    background-color: ${SURFACE} !important;
    color: ${ON_SURFACE} !important;
  }
}
