# yazi theme - Theme: ${THEME_NAME}
# Generated by theme-switch

[manager]
cwd = { fg = "${SECONDARY}" }

hovered         = { fg = "${ON_PRIMARY}", bg = "${PRIMARY}" }
preview_hovered = { underline = true }

find_keyword  = { fg = "${TERTIARY}", bold = true, italic = true, underline = true }
find_position = { fg = "${SECONDARY}", bg = "reset", bold = true, italic = true }

marker_copied   = { fg = "${COLOR2}", bg = "${COLOR2}" }
marker_cut      = { fg = "${ERROR}", bg = "${ERROR}" }
marker_marked   = { fg = "${SECONDARY}", bg = "${SECONDARY}" }
marker_selected = { fg = "${TERTIARY}", bg = "${TERTIARY}" }

tab_active   = { fg = "${ON_PRIMARY}", bg = "${PRIMARY}" }
tab_inactive = { fg = "${ON_SURFACE_VARIANT}", bg = "${SURFACE_CONTAINER}" }
tab_width    = 1

border_symbol = "│"
border_style  = { fg = "${OUTLINE_VARIANT}" }

[status]
separator_open  = ""
separator_close = ""

mode_normal = { fg = "${ON_PRIMARY}", bg = "${PRIMARY}", bold = true }
mode_select = { fg = "${ON_TERTIARY}", bg = "${TERTIARY}", bold = true }
mode_unset  = { fg = "${ON_SECONDARY}", bg = "${SECONDARY}", bold = true }

progress_label  = { bold = true }
progress_normal = { fg = "${PRIMARY}", bg = "${SURFACE_CONTAINER}" }
progress_error  = { fg = "${ERROR}", bg = "${SURFACE_CONTAINER}" }

permissions_t = { fg = "${PRIMARY}" }
permissions_r = { fg = "${TERTIARY}" }
permissions_w = { fg = "${ERROR}" }
permissions_x = { fg = "${COLOR2}" }
permissions_s = { fg = "${ON_SURFACE_VARIANT}" }

[input]
border   = { fg = "${PRIMARY}" }
title    = {}
value    = {}
selected = { reversed = true }

[select]
border   = { fg = "${PRIMARY}" }
active   = { fg = "${TERTIARY}" }
inactive = {}

[tasks]
border  = { fg = "${PRIMARY}" }
title   = {}
hovered = { fg = "${TERTIARY}", underline = true }

[which]
mask            = { bg = "${SURFACE_CONTAINER}" }
cand            = { fg = "${SECONDARY}" }
rest            = { fg = "${ON_SURFACE_VARIANT}" }
desc            = { fg = "${TERTIARY}" }
separator       = "  "
separator_style = { fg = "${OUTLINE}" }

[help]
on      = { fg = "${SECONDARY}" }
run     = { fg = "${TERTIARY}" }
hovered = { reversed = true, bold = true }
footer  = { fg = "${SURFACE}", bg = "${ON_SURFACE}" }
