# yazi theme - Theme: ${THEME_NAME}
# Generated by theme-switch

[mgr]
cwd = { fg = "${SECONDARY}" }

find_keyword  = { fg = "${TERTIARY}", bold = true, italic = true, underline = true }
find_position = { fg = "${SECONDARY}", bg = "reset", bold = true, italic = true }

symlink_target = { italic = true }

marker_copied   = { fg = "${COLOR2}", bg = "${COLOR2}" }
marker_cut      = { fg = "${ERROR}", bg = "${ERROR}" }
marker_marked   = { fg = "${SECONDARY}", bg = "${SECONDARY}" }
marker_selected = { fg = "${TERTIARY}", bg = "${TERTIARY}" }

count_copied   = { fg = "${SURFACE}", bg = "${COLOR2}" }
count_cut      = { fg = "${ON_ERROR}", bg = "${ERROR}" }
count_selected = { fg = "${ON_TERTIARY}", bg = "${TERTIARY}" }

border_symbol = "│"
border_style  = { fg = "${OUTLINE_VARIANT}" }

[tabs]
active   = { fg = "${ON_PRIMARY}", bg = "${PRIMARY}" }
inactive = { fg = "${ON_SURFACE_VARIANT}", bg = "${SURFACE_CONTAINER}" }

[mode]
normal_main = { fg = "${ON_PRIMARY}", bg = "${PRIMARY}", bold = true }
normal_alt  = { fg = "${PRIMARY}", bg = "${SURFACE_CONTAINER}" }

select_main = { fg = "${ON_TERTIARY}", bg = "${TERTIARY}", bold = true }
select_alt  = { fg = "${TERTIARY}", bg = "${SURFACE_CONTAINER}" }

unset_main = { fg = "${ON_SECONDARY}", bg = "${SECONDARY}", bold = true }
unset_alt  = { fg = "${SECONDARY}", bg = "${SURFACE_CONTAINER}" }

[indicator]
preview = { underline = true }

[status]
sep_left  = { open = "", close = "" }
sep_right = { open = "", close = "" }

perm_sep   = { fg = "${ON_SURFACE_VARIANT}" }
perm_type  = { fg = "${PRIMARY}" }
perm_read  = { fg = "${TERTIARY}" }
perm_write = { fg = "${ERROR}" }
perm_exec  = { fg = "${COLOR2}" }

progress_label  = { bold = true }
progress_normal = { fg = "${PRIMARY}", bg = "${SURFACE_CONTAINER}" }
progress_error  = { fg = "${ERROR}", bg = "${SURFACE_CONTAINER}" }

[which]
border          = { fg = "${PRIMARY}" }
mask            = { bg = "${SURFACE_CONTAINER}" }
cand            = { fg = "${SECONDARY}" }
rest            = { fg = "${ON_SURFACE_VARIANT}" }
desc            = { fg = "${TERTIARY}" }
separator       = "  "
separator_style = { fg = "${OUTLINE}" }

[confirm]
border  = { fg = "${PRIMARY}" }
title   = { fg = "${PRIMARY}" }
body    = {}
list    = {}
btn_yes = { reversed = true }
btn_no  = {}

[spot]
border   = { fg = "${PRIMARY}" }
title    = { fg = "${PRIMARY}" }
tbl_col  = { fg = "${PRIMARY}" }
tbl_cell = { fg = "${TERTIARY}", reversed = true }

[notify]
title_info  = { fg = "${COLOR2}" }
title_warn  = { fg = "${COLOR3}" }
title_error = { fg = "${ERROR}" }

[pick]
border   = { fg = "${PRIMARY}" }
active   = { fg = "${TERTIARY}" }
inactive = {}

[input]
border   = { fg = "${PRIMARY}" }
title    = {}
value    = {}
selected = { reversed = true }

[cmp]
border   = { fg = "${PRIMARY}" }
active   = { reversed = true }
inactive = {}

[tasks]
border  = { fg = "${PRIMARY}" }
title   = {}
hovered = { fg = "${TERTIARY}", underline = true }

[help]
border  = { fg = "${PRIMARY}" }
chord   = { fg = "${SECONDARY}" }
action  = { fg = "${TERTIARY}" }
hovered = { reversed = true, bold = true }
